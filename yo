#!/usr/bin/env bash
set -Eeuo pipefail

ROOT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
PROMPT="yo"

usage() { echo "usage: $(basename "$0") <command> [--backend codex|claude] [--model MODEL] [--effort EFFORT] [--thread-source SOURCE] [--prompt TEXT] [--experiment|--experiment-status|--experiment-report]" >&2; exit 2; }

# Args: required first is the CLI command to invoke. It's either a canonical
# backend name ("codex"/"claude", e.g. `yo claude`) or any command pointing at a
# separate auth/config context ("codex-pro", "claude-perso"). --backend selects which
# runner flags to apply and is required unless the command is itself a backend
# name (then it's inferred), so the command name is free. COMMAND stays the
# actual command invoked and the per-command log/crontab key, so several
# coexist. Optional --model/--effort/--thread-source override the defaults (codex
# only for the latter two) so utils/codex_anchor_probe.py can vary them through
# this script instead of duplicating the codex invocation. Validate before
# logging so a bad/missing arg fails fast to stderr.
COMMAND="${1:-}"
[[ -n "$COMMAND" && "$COMMAND" != -* ]] || usage
shift

BACKEND=""
MODEL=""
EFFORT=""
THREAD_SOURCE=""
EXPERIMENT=false
NO_EXPERIMENT=false
EXPERIMENT_PROMPT=""
EXPERIMENT_VIEW=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --backend)       [[ $# -ge 2 ]] || usage; BACKEND="$2"; shift 2 ;;
    --model)         [[ $# -ge 2 ]] || usage; MODEL="$2"; shift 2 ;;
    --effort)        [[ $# -ge 2 ]] || usage; EFFORT="$2"; shift 2 ;;
    --thread-source) [[ $# -ge 2 ]] || usage; THREAD_SOURCE="$2"; shift 2 ;;
    --prompt)        [[ $# -ge 2 ]] || usage; PROMPT="$2"; EXPERIMENT_PROMPT="$2"; shift 2 ;;
    --experiment)    EXPERIMENT=true; shift ;;
    --no-experiment) NO_EXPERIMENT=true; shift ;;
    --experiment-status) [[ -z "$EXPERIMENT_VIEW" ]] || usage; EXPERIMENT_VIEW=--status; shift ;;
    --experiment-report) [[ -z "$EXPERIMENT_VIEW" ]] || usage; EXPERIMENT_VIEW=--report; shift ;;
    *)               usage ;;
  esac
done

# Resolve the backend (mirrors install.py's resolve_backend): a command that is
# itself a backend name is its own backend, and an explicit --backend must
# agree with it -- a conflicting one is a usage error, not a silent run through
# the wrong runner. Any other command needs --backend, since we can't tell which
# runner flags to apply otherwise.
case "$COMMAND" in
  codex|claude)
    if [[ -n "$BACKEND" && "$BACKEND" != "$COMMAND" ]]; then
      echo "error: command '$COMMAND' runs the $COMMAND backend, but --backend $BACKEND was given; drop --backend or pass --backend $COMMAND" >&2; exit 2
    fi
    BACKEND="$COMMAND"
    ;;
  *)
    [[ -n "$BACKEND" ]] || { echo "error: --backend (codex|claude) is required for command '$COMMAND'" >&2; exit 2; }
    ;;
esac
case "$BACKEND" in
  codex|claude) ;;
  *) echo "error: --backend must be 'codex' or 'claude', got '$BACKEND'" >&2; exit 2 ;;
esac

if [[ "$NO_EXPERIMENT" == true && ( "$EXPERIMENT" == true || -n "$EXPERIMENT_VIEW" ) ]]; then
  echo "error: --no-experiment conflicts with experiment options" >&2; exit 2
fi
if [[ "$EXPERIMENT" == true || -n "$EXPERIMENT_VIEW" ]]; then
  experiment_args=()
  [[ -n "$EXPERIMENT_VIEW" ]] && experiment_args=("$EXPERIMENT_VIEW")
  exec python3 "$ROOT_DIR/utils/experiments.py" "$COMMAND" --backend "$BACKEND" \
    --model "$MODEL" --effort "$EFFORT" --thread-source "$THREAD_SOURCE" \
    --prompt="$EXPERIMENT_PROMPT" \
    ${experiment_args[@]+"${experiment_args[@]}"}
fi

# Logs are named per command so separate runs stay separate.
LOG_DIR="$ROOT_DIR/logs"
LAST_MESSAGE_FILE="$LOG_DIR/yo-$COMMAND.last.txt"

mkdir -p "$LOG_DIR"
timestamp="$(date -u +%Y%m%dT%H%M%SZ)"
log_file="$LOG_DIR/yo-$COMMAND-$timestamp.log"

run_codex() {
  # Keep manual pings and experiments on the same production invocation.
  local model="${MODEL:-gpt-5.6-terra}"
  local effort="${EFFORT:-medium}"
  local ts_args=()
  [[ -n "$THREAD_SOURCE" ]] && ts_args=(--thread-source "$THREAD_SOURCE")
  echo "agent=$COMMAND backend=codex model=$model reasoning_effort=$effort thread_source=${THREAD_SOURCE:-user(default)}"
  "$COMMAND" exec \
    ${ts_args[@]+"${ts_args[@]}"} \
    --ignore-rules \
    --skip-git-repo-check \
    --sandbox read-only \
    --color never \
    --output-last-message "$LAST_MESSAGE_FILE" \
    -m "$model" \
    -c "model_reasoning_effort=\"$effort\"" \
    -c 'model_reasoning_summary="none"' \
    -c 'model_verbosity="low"' \
    -c "include_environment_context=false" \
    -c "include_apps_instructions=false" \
    -c "include_collaboration_mode_instructions=false" \
    -c "project_doc_max_bytes=0" \
    -c "tool_output_token_limit=1024" \
    "$PROMPT"
}

run_claude() {
  local model="${MODEL:-haiku}" rc
  echo "agent=$COMMAND backend=claude model=$model"
  # --print: non-interactive. default permission mode keeps it non-blocking and
  # read-only (in print mode an unpermitted tool call is denied, not prompted).
  # stdout is the final message; capture it, then echo into the log. Capture
  # claude's exit code before cat so we report the real status.
  "$COMMAND" \
    --print \
    --model "$model" \
    --output-format text \
    --permission-mode default \
    "$PROMPT" >"$LAST_MESSAGE_FILE"
  rc=$?
  cat "$LAST_MESSAGE_FILE"
  return "$rc"
}

{
  echo "[$(date -Is)] yo start"
  echo "root=$ROOT_DIR"

  cd "$ROOT_DIR"

  set +e
  case "$BACKEND" in
    codex)  run_codex ;;
    claude) run_claude ;;
  esac
  rc=$?
  set -e

  echo "[$(date -Is)] yo end rc=$rc"
  exit "$rc"
} >>"$log_file" 2>&1
