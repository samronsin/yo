#!/usr/bin/env bash
set -Eeuo pipefail

ROOT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
PROMPT="yo"

usage() { echo "usage: $(basename "$0") <codex|claude> [--model MODEL]" >&2; exit 2; }

# Args: required first is the CLI to drive ("codex" or "claude", e.g.
# `yo claude`); optional --model overrides the model (else a per-agent default).
# Validate before logging so a bad/missing arg fails fast to stderr.
AGENT="${1:-}"
case "$AGENT" in
  codex|claude) shift ;;
  *) usage ;;
esac

MODEL=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --model) [[ $# -ge 2 ]] || usage; MODEL="$2"; shift 2 ;;
    *)       usage ;;
  esac
done

# Logs are named per CLI so codex and claude runs stay separate.
LOG_DIR="$ROOT_DIR/logs"
LAST_MESSAGE_FILE="$LOG_DIR/yo-$AGENT.last.txt"

mkdir -p "$LOG_DIR"
timestamp="$(date -u +%Y%m%dT%H%M%SZ)"
log_file="$LOG_DIR/yo-$AGENT-$timestamp.log"

run_codex() {
  # --thread-source scheduled is what anchors the 5h window: A/B pings in the
  # same unanchored gap on 2026-08-28 (see PR #14) showed gpt-5.4@medium with
  # thread_source=user does NOT anchor while the identical ping with
  # thread_source=scheduled locks resetsAt at ping+5h; effort is irrelevant
  # (mini@low anchored too), so keep effort at medium. Requires codex >= 0.150: older CLIs reject the
  # flag with rc=2 before reaching the API, which cron logs swallow silently.
  # Still no --ephemeral (b4ed61a: ephemeral runs only join, never anchor) and
  # no --ignore-user-config (29b9fe7: drops ~/.codex/config.toml settings the
  # ping needs). Non-ephemeral also persists runs to ~/.codex/sessions for
  # auditing from cron logs.
  # gpt-5.4 retires 2026-08-31T19:00Z; gpt-5.6-terra is its upgrade target
  # and is proven to anchor (04:30Z cron 2026-08-29). gpt-5.6-luna does NOT
  # anchor despite identical flags/effort (A/B 2026-08-29 09:32-09:39Z, see
  # PR #14) — anchoring is model-dependent, so don't swap models without
  # re-testing in an unanchored gap.
  local model="${MODEL:-gpt-5.6-terra}"
  echo "agent=codex model=$model reasoning_effort=medium thread_source=scheduled"
  codex exec \
    --thread-source scheduled \
    --ignore-rules \
    --skip-git-repo-check \
    --sandbox read-only \
    --color never \
    --output-last-message "$LAST_MESSAGE_FILE" \
    -m "$model" \
    -c 'model_reasoning_effort="medium"' \
    -c 'model_reasoning_summary="none"' \
    -c 'model_verbosity="low"' \
    -c "include_environment_context=false" \
    -c "include_apps_instructions=false" \
    -c "include_collaboration_mode_instructions=false" \
    -c "project_doc_max_bytes=0" \
    -c "tool_output_token_limit=1024" \
    "$PROMPT"
}

run_claude() {
  local model="${MODEL:-haiku}" rc
  echo "agent=claude model=$model"
  # --print: non-interactive. default permission mode keeps it non-blocking and
  # read-only (in print mode an unpermitted tool call is denied, not prompted).
  # stdout is the final message; capture it, then echo into the log. Capture
  # claude's exit code before cat so we report the real status.
  claude \
    --print \
    --model "$model" \
    --output-format text \
    --permission-mode default \
    "$PROMPT" >"$LAST_MESSAGE_FILE"
  rc=$?
  cat "$LAST_MESSAGE_FILE"
  return "$rc"
}

{
  echo "[$(date -Is)] yo start"
  echo "root=$ROOT_DIR"

  cd "$ROOT_DIR"

  set +e
  case "$AGENT" in
    codex)  run_codex ;;
    claude) run_claude ;;
  esac
  rc=$?
  set -e

  echo "[$(date -Is)] yo end rc=$rc"
  exit "$rc"
} >>"$log_file" 2>&1
