#!/usr/bin/env bash
set -Eeuo pipefail

ROOT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
PROMPT="yo"

usage() { echo "usage: $(basename "$0") <command> [--backend codex|claude] [--model MODEL] [--effort EFFORT] [--thread-source SOURCE] [--no-record]" >&2; exit 2; }

# Args: required first is the CLI command to invoke. It's either a canonical
# backend name ("codex"/"claude", e.g. `yo claude`) or any command pointing at a
# separate auth/config context ("codex-pro", "claude-perso"). --backend selects which
# runner flags to apply and is required unless the command is itself a backend
# name (then it's inferred), so the command name is free. COMMAND stays the
# actual command invoked and the per-command log/crontab key, so several
# coexist. Optional --model/--effort/--thread-source override the defaults
# (codex only for the latter two) so the recorder can vary them through this
# script instead of duplicating the codex invocation. Validate before logging
# so a bad/missing arg fails fast to stderr.
COMMAND="${1:-}"
[[ -n "$COMMAND" && "$COMMAND" != -* ]] || usage
shift

BACKEND=""
MODEL=""
EFFORT=""
THREAD_SOURCE=""
NO_RECORD=false
while [[ $# -gt 0 ]]; do
  case "$1" in
    --backend)       [[ $# -ge 2 ]] || usage; BACKEND="$2"; shift 2 ;;
    --model)         [[ $# -ge 2 ]] || usage; MODEL="$2"; shift 2 ;;
    --effort)        [[ $# -ge 2 ]] || usage; EFFORT="$2"; shift 2 ;;
    --thread-source) [[ $# -ge 2 ]] || usage; THREAD_SOURCE="$2"; shift 2 ;;
    --no-record)     NO_RECORD=true; shift ;;
    *)               usage ;;
  esac
done

# Resolve the backend (mirrors install.py's resolve_backend): a command that is
# itself a backend name is its own backend, and an explicit --backend must
# agree with it -- a conflicting one is a usage error, not a silent run through
# the wrong runner. Any other command needs --backend, since we can't tell which
# runner flags to apply otherwise.
case "$COMMAND" in
  codex|claude)
    if [[ -n "$BACKEND" && "$BACKEND" != "$COMMAND" ]]; then
      echo "error: command '$COMMAND' runs the $COMMAND backend, but --backend $BACKEND was given; drop --backend or pass --backend $COMMAND" >&2; exit 2
    fi
    BACKEND="$COMMAND"
    ;;
  *)
    [[ -n "$BACKEND" ]] || { echo "error: --backend (codex|claude) is required for command '$COMMAND'" >&2; exit 2; }
    ;;
esac
case "$BACKEND" in
  codex|claude) ;;
  *) echo "error: --backend must be 'codex' or 'claude', got '$BACKEND'" >&2; exit 2 ;;
esac

# Every Codex ping is verified against the account's quota reset and recorded
# at the end of its own run log as a `record: {...}` line (utils/codex_pings.py).
# The recorder sends the actual ping by calling back here with --no-record,
# which is also the raw path for a quick unrecorded smoke test. Claude has no
# quota observer, so it always takes the plain path.
if [[ "$BACKEND" == codex && "$NO_RECORD" != true ]]; then
  exec python3 "$ROOT_DIR/utils/codex_pings.py" "$COMMAND" \
    --model "$MODEL" --effort "$EFFORT" --thread-source "$THREAD_SOURCE"
fi

# Logs are named per command so separate runs stay separate. The recorder
# names the file itself (YO_LOG_FILE) so it can read the ping's details back.
LOG_DIR="$ROOT_DIR/logs"
LAST_MESSAGE_FILE="$LOG_DIR/yo-$COMMAND.last.txt"

mkdir -p "$LOG_DIR"
timestamp="$(date -u +%Y%m%dT%H%M%SZ)"
log_file="${YO_LOG_FILE:-$LOG_DIR/yo-$COMMAND-$timestamp.log}"

run_codex() {
  # Anchoring the 5h usage window is model-dependent (single-variable A/B
  # pings in unanchored gaps, 2026-08-28/29, see PR #14): gpt-5.6-terra
  # anchors with this plain invocation, gpt-5.4 only anchored with
  # --thread-source scheduled (a codex >= 0.150 flag), and gpt-5.6-luna never
  # anchors. Effort is irrelevant (mini@low anchored too), so keep medium.
  # Default to gpt-5.6-terra — gpt-5.4's catalog upgrade target (gpt-5.4
  # retires 2026-08-31T19:00Z), proven end-to-end by the 2026-08-29 04:30Z
  # cron ping. Don't swap models without re-testing in an unanchored gap.
  # Still no --ephemeral (b4ed61a: ephemeral runs only join, never anchor) and
  # no --ignore-user-config (29b9fe7: drops ~/.codex/config.toml settings the
  # ping needs). Non-ephemeral also persists runs to ~/.codex/sessions for
  # auditing from cron logs. Every recorded ping now carries its own verdict
  # (the `record:` line in its run log), so check there before trusting the above.
  local model="${MODEL:-gpt-5.6-terra}"
  local effort="${EFFORT:-medium}"
  local ts_args=()
  [[ -n "$THREAD_SOURCE" ]] && ts_args=(--thread-source "$THREAD_SOURCE")
  # Unset --thread-source means codex's own default, "user" (verified on the
  # wire for 0.150.x); log the effective value so bisection trails read true.
  # The recorder parses this line, so keep its shape.
  echo "agent=$COMMAND backend=codex model=$model reasoning_effort=$effort thread_source=${THREAD_SOURCE:-user(default)}"
  "$COMMAND" exec \
    ${ts_args[@]+"${ts_args[@]}"} \
    --ignore-rules \
    --skip-git-repo-check \
    --sandbox read-only \
    --color never \
    --output-last-message "$LAST_MESSAGE_FILE" \
    -m "$model" \
    -c "model_reasoning_effort=\"$effort\"" \
    -c 'model_reasoning_summary="none"' \
    -c 'model_verbosity="low"' \
    -c "include_environment_context=false" \
    -c "include_apps_instructions=false" \
    -c "include_collaboration_mode_instructions=false" \
    -c "project_doc_max_bytes=0" \
    -c "tool_output_token_limit=1024" \
    "$PROMPT"
}

run_claude() {
  local model="${MODEL:-haiku}" rc
  echo "agent=$COMMAND backend=claude model=$model"
  # --print: non-interactive. default permission mode keeps it non-blocking and
  # read-only (in print mode an unpermitted tool call is denied, not prompted).
  # stdout is the final message; capture it, then echo into the log. Capture
  # claude's exit code before cat so we report the real status.
  "$COMMAND" \
    --print \
    --model "$model" \
    --output-format text \
    --permission-mode default \
    "$PROMPT" >"$LAST_MESSAGE_FILE"
  rc=$?
  cat "$LAST_MESSAGE_FILE"
  return "$rc"
}

{
  echo "[$(date -Is)] yo start"
  echo "root=$ROOT_DIR"

  cd "$ROOT_DIR"

  set +e
  case "$BACKEND" in
    codex)  run_codex ;;
    claude) run_claude ;;
  esac
  rc=$?
  set -e

  echo "[$(date -Is)] yo end rc=$rc"
  exit "$rc"
} >>"$log_file" 2>&1
